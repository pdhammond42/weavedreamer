<assembly xmlns="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/plugins/maven-assembly-plugin/assembly/1.1.2 http://maven.apache.org/xsd/assembly-1.1.2.xsd">
    <id>bin</id>
    <formats>
        <format>zip</format>
    </formats>
    <componentDescriptors>
        <componentDescriptor>src/assembly/component-common.xml</componentDescriptor>
    </componentDescriptors>
    <fileSets>
        <!-- jlink runtime built by makeruntime.sh. fileMode 0755 keeps the
             bin/ launcher and java binary executable (assembly drops the
             exec bit unless a fileMode is set). -->
        <fileSet>
            <directory>${project.basedir}/runtime/linux_x64</directory>
            <outputDirectory>runtime</outputDirectory>
            <fileMode>0755</fileMode>
            <directoryMode>0755</directoryMode>
        </fileSet>
    </fileSets>
</assembly>
